# ==============================================================================
# JumpServer Kiosk Manager - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. JumpServer Connection Settings (JumpServer v4.10.x CE)
# ------------------------------------------------------------------------------
# Primary prefix is JMS_*. The application also supports transparent JUMPSERVER_* aliases.
JMS_BASE_URL=http://127.0.0.1:80
# JUMPSERVER_BASE_URL=http://127.0.0.1:80

# AccessKey credentials (if empty, auto-discovered via /var/run/docker.sock from jms_core)
JMS_KEY_ID=
# JUMPSERVER_KEY_ID=

# AccessKey secret (use either direct env var, or mount a 0600 secret file)
JMS_SECRET_KEY=
# JUMPSERVER_KEY_SECRET=
# JMS_SECRET_FILE=/app/secrets/jms_secret.key

# JumpServer v4 Organization UUID (Default System Org is 00000000-0000-0000-0000-000000000002)
JMS_ORG_ID=00000000-0000-0000-0000-000000000002
# JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002

# Credentials persistent cache file path (populated by autodiscovery)
JMS_CREDENTIALS_CACHE=/app/data/jms_credentials.json

# HTTP Client Settings
JMS_VERIFY_SSL=false
JMS_TIMEOUT=30.0
JMS_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 2. Docker Daemon & Runtime Settings
# ------------------------------------------------------------------------------
# Standard Docker daemon UNIX socket (mounted into backend container for autodiscovery & JIT)
DOCKER_HOST=unix:///var/run/docker.sock

# ------------------------------------------------------------------------------
# 3. Kiosk Manager Host & Network Pool
# ------------------------------------------------------------------------------
# Host IP registered in JumpServer for RDP sessions (leave blank to auto-detect LAN IP)
KIOSK_HOST_IP=

# RDP TCP port range for the Dispatcher pool
KIOSK_PORT_RANGE_START=33891
KIOSK_PORT_RANGE_END=33920

# Ephemeral Kiosk container image
KIOSK_DOCKER_IMAGE=ghcr.io/larentimatias7-oss/jumpsrv/pam-web-kiosk:latest

# ------------------------------------------------------------------------------
# 4. Portal Administration & Security
# ------------------------------------------------------------------------------
# HTTP Basic Auth credentials for Web Dashboard (:8080) and API (:8000)
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=admin

# Random secret string for application signing
SECRET_KEY=generate-a-secure-random-string-for-session-signing

# ------------------------------------------------------------------------------
# 5. Session Lifecycle & RAM Conservation Policies
# ------------------------------------------------------------------------------
# Grace window in seconds after last client disconnect before stopping container (default: 30)
KIOSK_DISCONNECT_GRACE_SECONDS=30

# Inactivity timeout in seconds without RDP traffic before force stopping container (default: 900 / 15m)
KIOSK_IDLE_TIMEOUT_SECONDS=900

# Absolute continuous session lifetime limit in seconds (default: 14400 / 4h)
KIOSK_MAX_SESSION_LIFETIME_SECONDS=14400

# ------------------------------------------------------------------------------
# 6. Database
# ------------------------------------------------------------------------------
# SQLite with WAL mode inside the persistent container volume
DATABASE_URL=sqlite:////app/data/kiosk.db
