# JumpServer Connection Settings
JMS_BASE_URL=https://192.168.1.220
JMS_KEY_ID=your-jumpserver-access-key-id
JMS_SECRET_FILE=/opt/kiosk-portal/config/jms_key.secret
JMS_ORG_ID=00000000-0000-0000-0000-000000000002
JMS_VERIFY_SSL=false
JMS_TIMEOUT=30.0
JMS_MAX_RETRIES=3

# Kiosk Manager Host & Network
KIOSK_HOST_IP=192.168.1.220
KIOSK_PORT_RANGE_START=33891
KIOSK_PORT_RANGE_END=33920
KIOSK_DOCKER_SOCKET=/run/user/1001/docker.sock
KIOSK_IMAGE_TAG=pam-web-kiosk:v1

# Application Security
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=change-me-immediately
SECRET_KEY=change-this-random-string-for-session-signing

# Database
DATABASE_URL=sqlite:////opt/kiosk-portal/data/kiosk.db
